rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Access list: document id = lowercase Google email, field role = 'admin' | 'member'.
    // Managed by hand in the Firebase console (clients can never write it).
    function isMember() {
      return request.auth != null && request.auth.token.email_verified
        && exists(/databases/$(db)/documents/access/$(request.auth.token.email.lower()));
    }
    function isAdmin() {
      return isMember()
        && get(/databases/$(db)/documents/access/$(request.auth.token.email.lower())).data.role == 'admin';
    }
    match /access/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      allow write: if false;
    }
    match /members/{id} { allow read: if isMember(); allow write: if isAdmin(); }
    match /unions/{id}  { allow read: if isMember(); allow write: if isAdmin(); }
  }
}
